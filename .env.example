# ╔══════════════════════════════════════════════════════════════╗
# ║   Tax Pro Hub University — Environment Variables            ║
# ║   Copy to .env.local and fill in real values               ║
# ║   NEVER commit .env.local to git                           ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Supabase (Auth + Database) ────────────────────────────────
# Create project at https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key

# ── App Config ────────────────────────────────────────────────
VITE_APP_NAME=Tax Pro Hub University
VITE_APP_URL=https://taxprohubuniversity.pages.dev

# ── AI / LLM (server-side via /api/llm/chat) ─────────────────
# Set as Cloudflare Pages secrets, NOT here:
#   wrangler pages secret put OPENAI_API_KEY
#   wrangler pages secret put OPENAI_BASE_URL   (optional, e.g. https://openrouter.ai/api/v1)
#   wrangler pages secret put OPENAI_MODEL      (optional, e.g. gpt-4o-mini)

# ── Twilio (server-side via /api/sms/*) ──────────────────────
# Set as Cloudflare Pages secrets:
#   wrangler pages secret put TWILIO_ACCOUNT_SID
#   wrangler pages secret put TWILIO_AUTH_TOKEN
#   wrangler pages secret put TWILIO_FROM_NUMBER

# ── Stripe (server-side via /api/stripe/*) ───────────────────
# Set as Cloudflare Pages secrets:
#   wrangler pages secret put STRIPE_SECRET_KEY
#   wrangler pages secret put STRIPE_WEBHOOK_SECRET
#   wrangler pages secret put STRIPE_PRICE_STARTER       (price_xxxxx)
#   wrangler pages secret put STRIPE_PRICE_GROWTH        (price_xxxxx)
#   wrangler pages secret put STRIPE_PRICE_ENTERPRISE   (price_xxxxx)

# ── Resend (email) ────────────────────────────────────────────
# Set as Cloudflare Pages secrets:
#   wrangler pages secret put RESEND_API_KEY
#   wrangler pages secret put MAIL_FROM              (e.g. no-reply@taxprohubuniversity.com)

# ── Cloudflare Calls (video) ──────────────────────────────────
# Create app at dash.cloudflare.com → Calls
#   wrangler pages secret put CF_CALLS_APP_ID
#   wrangler pages secret put CF_CALLS_APP_SECRET

# ── Supabase Service Role (server-side auth proxy) ────────────
# Set as Cloudflare Pages secrets:
#   wrangler pages secret put SUPABASE_URL              (same as VITE_SUPABASE_URL)
#   wrangler pages secret put SUPABASE_SERVICE_ROLE_KEY (from Supabase Settings → API)

# ── GoHighLevel CRM ───────────────────────────────────────────
# Set as Cloudflare Pages secrets:
#   wrangler pages secret put GHL_API_KEY           (pit-xxxxx from GHL settings)
#   wrangler pages secret put GHL_LOCATION_ID
#   wrangler pages secret put GHL_PIPELINE_ID
#   wrangler pages secret put GHL_STAGE_ID

# ── Cloudflare KV (already bound in wrangler.toml) ───────────
# LEDGER KV namespace ID: efc2da2c19934e68a956a84bfe76f7a2
# Used for: contacts, payouts, referrals, API keys, inbound SMS threads, Stripe events
