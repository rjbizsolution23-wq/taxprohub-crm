{
  "name": "tax-pro-hub-university",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cf:setup": "node scripts/setup-cf.mjs",
    "cf:dev": "npm run build && npx wrangler pages dev dist --local",
    "db:migrate": "for f in migrations/*.sql; do npx wrangler d1 execute taxprohub-crm --remote --file \"$f\"; done",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name tax-pro-hub-university",
    "ship": "node scripts/ship.mjs",
    "db:migrate:local": "for f in migrations/*.sql; do npx wrangler d1 execute taxprohub-crm --local --file \"$f\"; done"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "clsx": "2.1.1",
    "date-fns": "^4.2.1",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.76.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
